{
  "name": "@state-flow/monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @state-flow/visualizer dev",
    "build": "pnpm --filter @state-flow/visualizer build",
    "preview": "pnpm --filter @state-flow/visualizer preview",
    "clean": "rm -rf dist packages/*/dist",
    "lint": "pnpm --filter \"./packages/*\" lint",
    "extract": "pnpm --filter @state-flow/extractor extract",
    "extract:all": "pnpm --filter @state-flow/extractor extract:all && cp -r examples/graphs/* packages/visualizer/public/graphs/"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
